project_name         = "aws-devops-app"
environment          = "production"
aws_region           = "us-east-1"
domain_name          = "yourdomain.com"   # Replace with your domain
instance_type        = "t3.small"
asg_min_size         = 1
asg_max_size         = 4
asg_desired_capacity = 2
db_instance_class    = "db.t3.micro"
